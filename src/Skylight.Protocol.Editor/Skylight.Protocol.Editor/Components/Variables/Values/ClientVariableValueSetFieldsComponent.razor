@using Skylight.Protocol.Client.Variables
@using Skylight.Protocol.Client.Variables.Values

<div class="table-responsive editor-tree-branch">
	<h5 class="h6 mb-2">Fields</h5>
	@foreach ((string fieldCode, ClientVariableField field) in this.Variable.Fields)
	{
		if (!this.ValueSet.Fields.TryGetValue(fieldCode, out ClientVariableValueSetField? fieldValue))
		{
			fieldValue = new ClientVariableValueSetField();

			this.ValueSet.Fields.Add(fieldCode, fieldValue);
		}

		<div @key="fieldValue" class="mb-3 p-2">
			<div class="row g-2 mb-2 align-items-center">
				<div class="col-md-2"><code>@fieldCode</code></div>
				<div class="col-md-4">
					<input class="form-control form-control-sm" placeholder="Name"
						   value="@(fieldValue.Name ?? string.Empty)"
						   @onchange="e => fieldValue.Name = e.Value?.ToString() ?? string.Empty" />
				</div>
				<div class="col-md-6">
					<input class="form-control form-control-sm" placeholder="Description"
						   value="@(fieldValue.Description ?? string.Empty)"
						   @onchange="e => fieldValue.Description = e.Value?.ToString() ?? string.Empty" />
				</div>
			</div>
			<ClientVariableValuesComponent Field="fieldValue" />
		</div>
	}
</div>

@code
{
	[Parameter]
	public required ClientVariable Variable { get; set; }

	[Parameter]
	public required ClientVariableValueSet ValueSet { get; set; }

	private bool ruleSetsExpanded;
}
