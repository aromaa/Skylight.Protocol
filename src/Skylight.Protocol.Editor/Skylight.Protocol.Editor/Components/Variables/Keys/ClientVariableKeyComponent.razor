@using Skylight.Protocol.Client.Variables.Keys
@using Skylight.Protocol.Editor.Components.Variables.Rules

<tr>
	<td>
		<input class="form-control form-control-sm" value="@this.KeyCode" @onchange="e => this.RenameCallback.InvokeAsync(e.Value?.ToString() ?? this.KeyCode)" />
	</td>
	<td>
		<input class="form-control form-control-sm" value="@this.Key.Type" @onchange="e => this.Key.Type = e.Value?.ToString() ?? string.Empty" />
	</td>
	<td>
		<input class="form-control form-control-sm" value="@this.Key.Name" @onchange="e => this.Key.Name = e.Value?.ToString() ?? string.Empty" />
	</td>
	<td>
		<input class="form-control form-control-sm" value="@this.Key.Description" @onchange="e => this.Key.Description = e.Value?.ToString() ?? string.Empty" />
	</td>
	<td class="text-end">
		<button type="button" class="btn btn-outline-secondary btn-sm me-1" title="Move up"
				disabled="@(this.Index == 0)"
				@onclick="() => this.MoveCallback.InvokeAsync(-1)">
			↑
		</button>
		<button type="button" class="btn btn-outline-secondary btn-sm me-1" title="Move down"
				disabled="@(this.Index == this.KeySet.Keys.Count - 1)"
				@onclick="() => this.MoveCallback.InvokeAsync(1)">
			↓
		</button>
		<button type="button" class="btn @(this.expandRules ? "btn-outline-primary" : "btn-outline-secondary") btn-sm me-1"
				@onclick="() => this.expandRules = !this.expandRules">
			Rules <span class="badge bg-secondary">@this.Key.RuleSets.Count</span>
		</button>
		<button type="button" class="btn btn-outline-danger btn-sm" @onclick="this.RemoveCallback">
			Delete
		</button>
	</td>
</tr>

@if (this.expandRules)
{
	<tr>
		<td colspan="5" class="bg-light">
			<ClientVariableRuleSetsComponent RuleSets="this.Key.RuleSets" />
		</td>
	</tr>
}

@code
{
	[Parameter, EditorRequired]
	public required ClientVariableKeySet KeySet { get; set; }

	[Parameter, EditorRequired]
	public required int Index { get; set; }

	[Parameter, EditorRequired]
	public required string KeyCode { get; set; }

	[Parameter, EditorRequired]
	public required ClientVariableKey Key { get; set; }

	[Parameter, EditorRequired]
	public required EventCallback<string> RenameCallback { get; set; }

	[Parameter, EditorRequired]
	public required EventCallback<int> MoveCallback { get; set; }

	[Parameter, EditorRequired]
	public required EventCallback RemoveCallback { get; set; }

	private bool expandRules;
}
