@using Skylight.Protocol.Client.Variables.Entries
@using Skylight.Protocol.Client.Variables.Values
@using Skylight.Protocol.Editor.Components.Variables.Values

<div class="table-responsive editor-tree-branch">
	<table class="table table-sm align-middle mb-2">
		<thead>
			<tr>
				<th style="min-width:140px">Code</th>
				<th style="min-width:140px">Name</th>
				<th>Description</th>
				<th style="width:340px"></th>
			</tr>
		</thead>
		<tbody>
			@foreach ((string valueSetCode, ClientVariableValueSet valueSet) in this.Field.ValueSets)
			{
				int index = this.Field.ValueSets.IndexOf(valueSetCode);

				<ClientVariableValueSetComponent @key="valueSet" Field="this.Field" Index="index" ValueSetCode="@valueSetCode" ValueSet="valueSet" RenameCallback="code => this.RenameValueSet(index, code)" MoveCallback="offset => this.MoveValueSet(index, offset)" RemoveCallback="() => this.Field.ValueSets.RemoveAt(index)" />
			}
		</tbody>
	</table>
	<button type="button" class="btn btn-outline-primary btn-sm mb-2" @onclick="this.AddValueSet">
		+ Add value set
	</button>
</div>

@code
{
	[Parameter]
	public required ClientVariableStaticEntryValue Field { get; set; }

	private void AddValueSet()
	{
        ClientVariableValueSet valueSet = new();

		int i = 1;
		while (!this.Field.ValueSets.TryAdd($"VALUE_SET_{i++}", valueSet))
		{
		}
	}

	private void RenameValueSet(int index, string code)
	{
		if (this.Field.ValueSets.ContainsKey(code))
		{
			return;
		}

		this.Field.ValueSets.SetAt(index, code, this.Field.ValueSets.GetAt(index).Value);
	}

	private void MoveValueSet(int index, int offset)
	{
		int newIndex = index + offset;
		if (newIndex < 0 || newIndex >= this.Field.ValueSets.Count)
		{
			return;
		}

		(string code, ClientVariableValueSet valueSet) = this.Field.ValueSets.GetAt(index);

		this.Field.ValueSets.RemoveAt(index);
		this.Field.ValueSets.Insert(newIndex, code, valueSet);
	}
}
